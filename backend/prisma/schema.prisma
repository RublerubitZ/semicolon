generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connection pool settings for Railway and production
  // Add ?connection_limit=10&pool_timeout=30 to DATABASE_URL if needed
}

// 사용자
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  nickname     String?
  role         Role     @default(MENTEE)
  grade        String?  // 학년 (고1, 고2, 고3, 재수생 등)
  profileImage String?
  gender       String?  // 성별
  birthDate    String?  // 생년월일 (예: "2008.06.05")
  goal         String?  // 목표 (예: "수능 준비")
  phone        String?  // 휴대폰번호 (예: "010-1234-5678")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  menteeTasks            Task[]            @relation("MenteeTasks")
  mentorTasks            Task[]            @relation("MentorTasks")
  submissions            TaskSubmission[]
  feedbacksGiven         Feedback[]        @relation("FeedbacksMentor")
  feedbackComments       FeedbackComment[]
  worksheets             Worksheet[]
  studyTimeLogs          StudyTimeLog[]
  plannerComments        PlannerComment[]
  notifications          Notification[]
  mentorRelation         MentorMentee[]    @relation("Mentor")
  menteeRelation         MentorMentee[]    @relation("Mentee")
  dailyFeedbacksGiven    DailyFeedback[]   @relation("DailyFeedbacksMentor")
  dailyFeedbacksReceived DailyFeedback[]   @relation("DailyFeedbacksMentee")
  monthlyFeedbacksGiven    MonthlyFeedback[] @relation("MonthlyFeedbacksMentor")
  monthlyFeedbacksReceived MonthlyFeedback[] @relation("MonthlyFeedbacksMentee")
  weeklyFeedbacksGiven     WeeklyFeedback[]  @relation("WeeklyFeedbacksMentor")
  weeklyFeedbacksReceived  WeeklyFeedback[]  @relation("WeeklyFeedbacksMentee")
}

enum Role {
  MENTEE
  MENTOR
  ADMIN
}

// 멘티 자가점검 상태
enum SelfCheckStatus {
  PENDING     // 미시작 (○)
  IN_PROGRESS // 진행 중 (△)
  DONE        // 완료 (V)
  NOT_DONE    // 미진행 (X)
}

// 멘토-멘티 관계
model MentorMentee {
  id        String   @id @default(cuid())
  mentorId  String
  menteeId  String
  createdAt DateTime @default(now())

  mentor User @relation("Mentor", fields: [mentorId], references: [id])
  mentee User @relation("Mentee", fields: [menteeId], references: [id])

  @@unique([mentorId, menteeId])
}

// 할 일 (과제)
model Task {
  id          String   @id @default(cuid())
  menteeId    String
  mentorId    String?
  title       String
  description String?
  subject     String
  date        DateTime @db.Date
  worksheetId String?
  pdfUrl      String?
  isFixed     Boolean  @default(false)

  // [DEPRECATED] 멘토 승인으로 대체 예정 - 하위 호환용 유지
  isCompleted Boolean  @default(false)

  // [NEW] 멘티 자가점검 (V, △, X, ○) - 달성률 영향 없음
  selfCheck       SelfCheckStatus @default(PENDING)
  selfCheckedAt   DateTime?

  // [NEW] 멘토 승인 - 달성률 반영
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  approvedBy      String?   // 승인한 멘토 ID

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mentee           User               @relation("MenteeTasks", fields: [menteeId], references: [id])
  mentor           User?              @relation("MentorTasks", fields: [mentorId], references: [id])
  worksheet        Worksheet?         @relation(fields: [worksheetId], references: [id])
  submissions      TaskSubmission[]
  feedbacks        Feedback[]
  feedbackComments FeedbackComment[]
  studyLogs        StudyTimeLog[]
  learningGoal     LearningGoal?      // 학습 목표 (선택)

  @@index([menteeId, date])
  @@index([mentorId, date])
}

// 학습 목표
model LearningGoal {
  id        String   @id @default(cuid())
  taskId    String   @unique // 과제당 하나
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task  Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items LearningGoalItem[]
}

// 학습 목표 항목 (체크리스트)
model LearningGoalItem {
  id             String    @id @default(cuid())
  learningGoalId String
  title          String    // "주격조사 이해하기"
  order          Int       @default(0)
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  learningGoal LearningGoal @relation(fields: [learningGoalId], references: [id], onDelete: Cascade)

  @@index([learningGoalId])
}

// 과제 제출
model TaskSubmission {
  id        String   @id @default(cuid())
  taskId    String
  menteeId  String
  imageUrls String[]
  comment   String?
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  mentee User @relation(fields: [menteeId], references: [id])
}

// 피드백
model Feedback {
  id           String   @id @default(cuid())
  taskId       String
  mentorId     String
  content      String
  summary      String?
  subject      String
  feedbackDate DateTime @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id])
  mentor User @relation("FeedbacksMentor", fields: [mentorId], references: [id])
}

// 피드백 댓글 (채팅 형식)
model FeedbackComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String   // 멘토 또는 멘티
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("feedback_comments")
}

// 학습지
model Worksheet {
  id          String        @id @default(cuid())
  createdById String
  title       String
  subject     String
  content     String?
  pdfUrl      String?
  type        WorksheetType @default(COLUMN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy User   @relation(fields: [createdById], references: [id])
  tasks     Task[]
}

enum WorksheetType {
  COLUMN
  PDF
}

// 공부 시간 기록
model StudyTimeLog {
  id        String   @id @default(cuid())
  menteeId  String
  taskId    String?
  subject   String
  date      DateTime @db.Date
  duration  Int      // 분 단위 (기존 방식)

  // [NEW] 타임테이블용 시작/종료 시간
  startTime String?  // "06:00" 형식
  endTime   String?  // "07:30" 형식

  createdAt DateTime @default(now())

  mentee User  @relation(fields: [menteeId], references: [id])
  task   Task? @relation(fields: [taskId], references: [id])

  @@index([menteeId, date])
  @@index([menteeId, subject, date])
}

// 플래너 코멘트/질문
model PlannerComment {
  id        String   @id @default(cuid())
  menteeId  String
  date      DateTime @db.Date
  content   String
  createdAt DateTime @default(now())

  mentee User @relation(fields: [menteeId], references: [id])

  @@index([menteeId, date])
}

// 알림
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String?
  isRead    Boolean          @default(false)
  relatedId String?          // taskId, feedbackId 등 관련 리소스 ID
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum NotificationType {
  TASK_INCOMPLETE  // 과제 미완료 알림
  NEW_FEEDBACK     // 새로운 피드백
  REMINDER         // 리마인더
  NEW_TASK         // 새로운 과제 등록 (멘토 -> 멘티)
  TASK_SUBMITTED   // 과제 제출 (멘티 -> 멘토)
  TASK_APPROVED    // 과제 승인 (멘토 -> 멘티)
}

// 일일 전체 피드백
model DailyFeedback {
  id        String   @id @default(cuid())
  menteeId  String
  mentorId  String
  date      DateTime @db.Date
  content   String   // 일일 전체 피드백
  summary   String?  // 한 줄 요약
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentee User @relation("DailyFeedbacksMentee", fields: [menteeId], references: [id])
  mentor User @relation("DailyFeedbacksMentor", fields: [mentorId], references: [id])

  @@unique([menteeId, date]) // 멘티당 날짜별로 하나만
  @@index([menteeId, date])
}

// 월간 총평
model MonthlyFeedback {
  id              String   @id @default(cuid())
  menteeId        String
  mentorId        String
  year            Int
  month           Int
  overallComment  String   // 이번달 총평
  strengths       String   // 잘한점
  improvements    String   // 개선할점
  nextMonthGoals  String   // 다음달 목표
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mentee User @relation("MonthlyFeedbacksMentee", fields: [menteeId], references: [id])
  mentor User @relation("MonthlyFeedbacksMentor", fields: [mentorId], references: [id])

  @@unique([menteeId, year, month]) // 멘티당 월별로 하나만
  @@index([menteeId, year, month])
}

// 주간 총평
model WeeklyFeedback {
  id              String   @id @default(cuid())
  menteeId        String
  mentorId        String
  year            Int
  month           Int
  weekNumber      Int      // 1~5주차
  overallComment  String   // 이번주 총평
  strengths       String   // 잘한점
  improvements    String   // 개선할점
  nextWeekGoals   String   // 다음주 목표
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mentee User @relation("WeeklyFeedbacksMentee", fields: [menteeId], references: [id])
  mentor User @relation("WeeklyFeedbacksMentor", fields: [mentorId], references: [id])

  @@unique([menteeId, year, month, weekNumber]) // 멘티당 주별로 하나만
  @@index([menteeId, year, month])
}
